// Emarath — Prisma schema (FND-01.2: Core database setup & conventions)
// Docs: https://pris.ly/d/prisma-schema
//
// Shared field conventions (every future model MUST follow these):
//   id         String   @id @default(uuid()) @db.Uuid   -> column "id"
//   createdAt  DateTime @default(now())      @map("created_at")
//   updatedAt  DateTime @updatedAt           @map("updated_at")
//   deletedAt  DateTime?                     @map("deleted_at")  // soft-delete, where needed
//
// Naming: PascalCase models / camelCase fields in Prisma; snake_case tables &
// columns in PostgreSQL via @@map / @map. See README "Database conventions".

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Migration history proves the tooling round-trip required by FND-01.2 AC2:
//   20260715115025_init                 -> created "migration_check"
//   <ts>_drop_migration_check           -> rolled it back (reverse migration)
// The convention-check model was temporary scaffolding, never a domain entity,
// and held no application data.

/// The five user types the platform is built around (AUTH-01.1). Fixed by the
/// backlog rather than configurable — role administration is explicitly out of
/// scope — so an enum is the honest model.
enum UserRole {
  SUPERADMIN
  SALES_MANAGER
  SALES_AGENT
  CUSTOMER_SERVICE_AGENT
  MARKETING_ANALYST
}

/// The user account (AUTH-01.1). Stores credentials (email + username + a one-way
/// password hash), one profile field (name), exactly one role and one optional team
/// (AC1/AC3). `email` and `username` are both unique so a duplicate of either is
/// rejected at creation (AC5). Passwords are stored only as a bcrypt hash (AC4) —
/// never plaintext. Login, sessions and the JWT identity are AUTH-01.2/01.3, which
/// consume this model without reshaping it.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(180)
  /// Second credential AC5 dedupes alongside email.
  username     String   @unique @db.VarChar(120)
  /// bcrypt hash (AC4). Never the plaintext password.
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  /// Whether the account may log in (AUTH-01.2 AC4). Disabled accounts are rejected
  /// at login with the same generic error as bad credentials.
  isActive     Boolean  @default(true) @map("is_active")
  /// Team association, used later for role scoping (AUTH-01.1 AC1/AC3).
  team         String?  @db.VarChar(120)

  /// Profile fields the Team Members roster displays (Settings > Users & Access).
  /// Optional: every existing account predates them, and neither is a credential —
  /// `phone` is display/contact only and is NOT a login identity (see STATUS R-3).
  jobTitle String? @map("job_title") @db.VarChar(120)
  phone    String? @db.VarChar(32)

  /// Roster activity columns. `lastLoginAt` is stamped by a successful login;
  /// `lastSeenAt` also advances on token refresh, so it approximates presence without
  /// a write on every authenticated request. Null until the account first signs in.
  lastLoginAt DateTime? @map("last_login_at")
  lastSeenAt  DateTime? @map("last_seen_at")

  /// Wizard name split (the reference asks First/Last separately). `name` stays the
  /// canonical display value the whole product reads; these two exist so an edit can
  /// prefill real halves instead of guessing at a split of "ADWAITHA T M".
  firstName String? @map("first_name") @db.VarChar(80)
  lastName  String? @map("last_name") @db.VarChar(80)

  /// The organisational role the wizard picked (ADR-0055). Authorization does NOT read
  /// this: `role` (the enum) stays the JWT claim and the guard/scoping input, and the
  /// service sets it from Role.baseRole whenever roleId changes. Null on accounts that
  /// predate the roles table — display falls back to the enum label.
  roleId String? @map("role_id") @db.Uuid

  /// Who this member reports to (the wizard's "Reporting To"). Organisational only —
  /// no scoping reads it yet (the R-2 agent-tree question is still open).
  reportingToId String? @map("reporting_to_id") @db.Uuid

  /// The lead form assigned in the wizard's Permission step.
  leadFormId String? @map("lead_form_id") @db.Uuid

  /// Pipelines this member works (wizard's multi-select). Values come from the
  /// `pipelines` lookup — strings, because pipelines are lookup data, not a table.
  pipelines String[] @default([])

  /// Permissions & Tracking toggles (wizard step 3). All default off, matching the
  /// reference's fresh-member state; none is read by any guard yet — they are stored
  /// configuration surfaced back through the API.
  appAccess            Boolean @default(false) @map("app_access")
  trackCheckInOut      Boolean @default(false) @map("track_check_in_out")
  trackMeetingLocation Boolean @default(false) @map("track_meeting_location")
  includeInReporting   Boolean @default(false) @map("include_in_reporting")
  autoFollowUpPrompt   Boolean @default(false) @map("auto_follow_up_prompt")

  /// WhatsApp inbox access level ("RESTRICTED" | "FULL"), nullable = not set.
  whatsappInboxAccess String? @map("whatsapp_inbox_access") @db.VarChar(20)

  /// The member's picked button colour — user data (like a pin colour), not a design
  /// token, so it is stored as the hex the picker produced.
  colorCode String? @map("color_code") @db.VarChar(9)

  /// Target Settings: monthly goal in AED. Decimal, never float (money rule).
  monthlyGoalAmount Decimal? @map("monthly_goal_amount") @db.Decimal(12, 2)

  /// Profile picture's storage key (FND-05.2 store); responses carry a signed URL,
  /// never the key's raw location.
  avatarKey String? @map("avatar_key") @db.VarChar(300)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  assignments         LeadAssignment[]
  /// ADR-0031: this user's personal lead pins (their own float-to-top list).
  leadPins            LeadPin[]
  importJobs          ImportJob[]
  viewPreferences     UserViewPreference[]
  /// ADR-0052: this user's own saved filter presets (the filter panel's checkbox row).
  savedFilters        SavedFilter[]
  /// ACT-01.1 (ACT-06.1): activities this user is assigned to work.
  activityAssignments ActivityAssignee[]
  /// CALL-01.1: calls made or received by this agent.
  calls               Call[]
  /// GPS-01.1: field check-ins and passive tracking points for this agent.
  checkIns            CheckIn[]
  locationPoints      LocationPoint[]
  /// AUTH-01.3: refresh-token sessions (one lineage per device).
  refreshTokens       RefreshToken[]
  /// AUTH-03.1: outstanding/used password-reset tokens.
  passwordResetTokens PasswordResetToken[]
  /// DOC-01.1: documents this user uploaded (the "Uploaded By" audit trail).
  uploadedDocuments   Document[]
  /// DOC-01.1: per-document access grants naming this user.
  documentAccess      DocumentAccess[]
  /// LEAD-10.2 (ADR-0035): lead notes this user authored via the row "Add Note" action.
  leadNotes           LeadNote[]

  /// Settings > Users & Access: organisational role, reporting line, assigned lead
  /// form and the per-module permission matrix.
  orgRole           Role?                  @relation("UserOrgRole", fields: [roleId], references: [id], onDelete: Restrict)
  reportingTo       User?                  @relation("UserReportingTo", fields: [reportingToId], references: [id], onDelete: SetNull)
  reports           User[]                 @relation("UserReportingTo")
  /// Roles this user authored — surfaced by the Roles & Permissions info popover.
  rolesCreated      Role[]                 @relation("RoleCreatedBy")
  categoriesCreated Category[]             @relation("CategoryCreatedBy")
  leadForm          LeadForm?              @relation(fields: [leadFormId], references: [id], onDelete: Restrict)
  modulePermissions UserModulePermission[]

  @@map("users")
}

/// Settings > Users & Access (ADR-0055): a role in the organisation's own words —
/// "QC ROLE", "LOGISTICS MANAGER" — the wizard's Role dropdown lists.
///
/// Authorization deliberately does NOT read this table. Every row maps onto one of the
/// five seeded UserRole values via `baseRole`; the service copies that onto User.role
/// whenever roleId changes, so the JWT claim, RolesGuard and all data scoping keep
/// working off the enum exactly as before. Custom-role *creation* is the Roles &
/// Permissions screen's job; this task seeds the five built-ins.
model Role {
  id       String   @id @default(uuid()) @db.Uuid
  name     String   @unique @db.VarChar(120)
  baseRole UserRole @map("base_role")

  /// Hierarchy parent (ADR-0056). Null is a root role. `Restrict` rather than cascade:
  /// deleting a parent must never silently take its subtree — the service refuses while
  /// children remain, so a delete is always an explicit, one-role decision.
  parentId String? @map("parent_id") @db.Uuid
  parent   Role?   @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Role[]  @relation("RoleHierarchy")

  /// Order among siblings sharing a parent; the tree reads `[parentId, position]`.
  position Int @default(0)

  /// Author, for the info popover. Nullable because the seeded roles predate this
  /// column, and `SetNull` so removing a team member never deletes the roles they made.
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users User[] @relation("UserOrgRole")

  /// The tree is read whole, ordered by depth then sibling position; soft delete has no
  /// automatic filter (CLAUDE.md §11) so every query names deletedAt explicitly.
  @@index([deletedAt, parentId, position])
  @@map("roles")
}

/// Settings > Users & Access: a lead form the wizard's "Assign Lead Form" offers.
/// The form *builder* (Data & Schema Management) is separate scope; this is the
/// catalogue that assignment needs, seeded with the one built-in form.
model LeadForm {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(160)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users User[]

  @@map("lead_forms")
}

/// One row of the wizard's User Permissions matrix: what `userId` may do in `module`.
/// "All" is never stored — it is the derived state of every applicable flag being on.
/// Which flags are applicable per module is the permission catalogue (users DTO), and
/// the service rejects a write that sets an inapplicable flag, so a disabled cell can
/// not be forged through the API either.
model UserModulePermission {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  /// Catalogue key ("LEADS", "GPS_MAP", ...). A string, validated in the service —
  /// an enum would cost a migration per module for no integrity the catalogue check
  /// does not already give.
  module  String  @db.VarChar(40)
  canView Boolean @default(false) @map("can_view")
  canAdd  Boolean @default(false) @map("can_add")
  canEdit Boolean @default(false) @map("can_edit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@map("user_module_permissions")
}

/// A refresh-token session (AUTH-01.3, ADR-0029 §3). The token itself is an opaque
/// random value delivered to the client; only its sha-256 hash is stored here, so a DB
/// read never yields a usable token. `familyId` is the rotation lineage — one family per
/// login, i.e. per device (multi-device sessions are independent families). On refresh
/// the presented row is revoked (`revokedAt` + `replacedById`) and a new row is issued in
/// the same family; presenting an already-revoked token revokes the whole family (reuse =
/// theft). No soft-delete: a session is either live or revoked.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// sha-256 hex of the opaque token; the raw value is never stored.
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// The row that superseded this one on rotation (audit/theft trail).
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// A single-use password-reset token (AUTH-03.1, ADR-0031). Like RefreshToken, the raw
/// token is an opaque random value delivered only in the emailed link; the DB stores only
/// its sha-256 hash, so a read never yields a usable token. `usedAt` marks it spent
/// (single-use); `expiresAt` bounds its life. Requesting a reset invalidates the user's
/// earlier unused tokens, so at most one link is ever live. No soft-delete: a token is
/// live, used or expired. Completing a reset additionally revokes the user's refresh
/// sessions, so old sessions cannot outlive the password change.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// sha-256 hex of the opaque token; the raw value is never stored.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Core lead record (LEAD-01.1).
///
/// Optionality mirrors what Workpex marks required in the New Lead drawer
/// (`leads-add-new-lead-drawer-scroll-1-top.png`): Customer Name, Primary Phone
/// and Lead Status carry an asterisk; everything else is blank on real rows in
/// `leads-list-default-scroll-left-assigned-avatar-tooltip.png`.
///
/// Order, delivery, tags, complaint and outreach fields are deliberately absent:
/// they are LEAD-01.2 and LEAD-01.3, each with its own migration.
model Lead {
  id String @id @default(uuid()) @db.Uuid

  /// "Customer Name" in Workpex — the display name, not a person's given name.
  name           String  @db.VarChar(180)
  firstName      String? @map("first_name") @db.VarChar(120)
  primaryPhone   String  @map("primary_phone") @db.VarChar(32)
  secondaryPhone String? @map("secondary_phone") @db.VarChar(32)
  /// Optional contact email (ADR-0032). Nullable — most Workpex leads have none —
  /// so it stays a create-form concern, not a NOT NULL. Backs the row Email
  /// composer's To prefill and is the recipient a sent lead email defaults to.
  email          String? @db.VarChar(180)
  language       String? @db.VarChar(64)
  country        String? @db.VarChar(64)

  /// Origin channel (Workpex: DoubleTick, Broadcast, …).
  source String? @db.VarChar(64)

  /// LEAD-01.1 AC3: status and pipeline stage are ONE field. Workpex proves it —
  /// the Kanban columns in `kanban-board-default-legend-tooltip-converted.png`
  /// (New, Initial Contact, SUPER HOT, HOT, Cold, Warm) are the same values the
  /// card badges and the list's Lead Status column show. Modelling them twice
  /// would let a lead sit in one column while claiming another status.
  ///
  /// A string, not an enum: Workpex users define their own statuses and colours,
  /// so new values must not require a migration. The reference table and colour
  /// mapping belong to FND-04.2 / LEAD-11.1.
  status String @db.VarChar(64)

  /// LEAD-06.2 (ADR-0005): the pipeline/board a lead is routed to — Workpex values
  /// "Lead Pipeline", "Complaints", "LOGISTICS", "QC". This is a SEPARATE axis from
  /// `status`: status is the stage within a pipeline (New/HOT/WON — the Kanban
  /// columns), pipeline is the board the lead belongs to. The New Lead drawer and
  /// the list both show Lead Status and Lead Pipeline as distinct fields, so the
  /// original single-field assumption was incomplete. A configurable string like
  /// status/source; options come from a lookup provider. Defaulted so the additive
  /// migration backfills existing rows and the Workpex form's default is matched.
  pipeline String @default("Lead Pipeline") @map("pipeline") @db.VarChar(64)

  // ── LEAD-01.2: order & delivery ────────────────────────────────────────────
  //
  // Every field here is nullable even though the New Lead drawer stars Product,
  // Actual Amount and Payment Method. Real Workpex rows contradict the form:
  // `leads-manage-columns-drawer-open.png` shows leads with an empty QTY, and
  // imported records arrive without commercial detail at all. "Required" is a
  // rule about the create form, so it lives in the DTO (LEAD-06.1); a NOT NULL
  // here would reject data Workpex demonstrably holds.

  /// Two fixed product slots, not a collection: Workpex offers exactly Product
  /// and Product 2, and the criterion caps it at two. A child table would model
  /// a list the product does not have.
  ///
  /// Quantities are decimal because Workpex renders them "1.00" in the QTY
  /// column — an integer would silently truncate a half-unit order.
  product     String?  @db.VarChar(180)
  productQty  Decimal? @map("product_qty") @db.Decimal(12, 2)
  /// Free text, unlike `product`, which is a dropdown. Workpex's own asymmetry.
  product2    String?  @db.VarChar(180)
  product2Qty Decimal? @map("product2_qty") @db.Decimal(12, 2)

  /// Date only — Workpex captures no time of day for a booking.
  bookingDate DateTime? @map("booking_date") @db.Date
  category    String?   @db.VarChar(120)

  /// Confirmed vs expected value; both feed pipeline totals and revenue reports.
  /// Decimal, never float: AED totals must not drift on rounding.
  actualAmount     Decimal? @map("actual_amount") @db.Decimal(12, 2)
  forecastedAmount Decimal? @map("forecasted_amount") @db.Decimal(12, 2)

  /// A string, not an enum (AC3 asks only that values such as Cash on Delivery
  /// are supported); Workpex drives this from a configurable dropdown.
  paymentMethod String? @map("payment_method") @db.VarChar(64)

  /// Delivery address. `country` above completes it — the backlog puts country on
  /// the lead (LEAD-01.1 AC1) while Workpex draws it inside the Address section,
  /// so the field is shared rather than duplicated here.
  state        String? @db.VarChar(120)
  street       String? @db.VarChar(240)
  city         String? @db.VarChar(120)
  nationalCode String? @map("national_code") @db.VarChar(240)

  // ── LEAD-01.3: outreach ────────────────────────────────────────────────────

  /// Workpex values: Answered, No Response, Invalid Number. Nullable for the
  /// same reason as the fields above — real rows leave it blank.
  callStatus String? @map("call_status") @db.VarChar(64)

  /// Two counters, never one total: the criterion keeps call attempts and
  /// WhatsApp attempts separate, and Workpex columns them separately too.
  ///
  /// NOT NULL DEFAULT 0 per AC5. Workpex shows some cells blank, which would
  /// mean NULL; a counter that can be null forces every reader to treat absent
  /// and zero as the same thing, and the criterion is explicit that they default
  /// to zero. Recorded as a display difference rather than modelled as one.
  callAttempts     Int @default(0) @map("call_attempts")
  whatsappAttempts Int @default(0) @map("whatsapp_attempts")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  /// When `status` last changed — kept by the `leads_status_changed_at` trigger
  /// (migration 20260830120000), never by app code, so every write path stays covered.
  /// Backfilled to `created_at`. Drives the Leads By Status report's "Status Changed
  /// Date" window (RPT-02.3)
  /// Why the lead was lost (RPT-02.7 v2). Set when status moves to LOST, cleared when it
  /// leaves LOST; null on historical losses ("No reason recorded"). Values come from the
  /// lostReasons lookup — a string, not an enum, so the business can edit the catalogue
  /// without a migration (the same rule as `status`).
  lostReason String?   @map("lost_reason") @db.VarChar(120)

  statusChangedAt DateTime @default(now()) @map("status_changed_at")

  assignments       LeadAssignment[]
  tags              LeadTag[]
  complaints        Complaint[]
  /// ACT-01.1: follow-ups on this lead. Independent of the lead's stage — an
  /// activity links to the lead, not to a status/pipeline (ADR-0027 dec 7).
  activities        Activity[]
  /// CALL-01.1: call records linked to this lead.
  calls             Call[]
  /// Per-user pins (ADR-0031): one row per user who has pinned this lead so it
  /// floats to the top of their own list. Personal, never shared.
  pins              LeadPin[]
  /// LEAD-10.2 (ADR-0035): free-text notes added from the row "Add Note" action.
  notes             LeadNote[]
  /// LEAD-05.1 (ADR-0051): per-lead values for user-defined custom columns.
  customFieldValues LeadCustomFieldValue[]

  /// AC2: the fields the list and board filter and group by are indexed.
  /// Each is paired with deletedAt because every query must exclude soft-deleted
  /// rows, so that predicate is always present alongside them.
  @@index([status, deletedAt])
  @@index([source, deletedAt])
  @@index([pipeline, deletedAt])
  @@index([createdAt(sort: Desc)])
  /// LEAD-03.1: substring search on Customer Name and Primary Phone. `contains`
  /// compiles to ILIKE '%term%', whose leading wildcard a btree cannot use, so
  /// these are GIN trigram indexes (pg_trgm) — the index that makes an unanchored
  /// ILIKE fast at 15,000+ rows. Declared here so Prisma owns them and no drift
  /// results; the extension itself is enabled in the migration.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([primaryPhone(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("leads")
}

/// Lead-to-agent assignment (LEAD-01.1 AC4). An explicit join rather than an
/// implicit m-n relation: Workpex shows an "Assigned Date" column, so the link
/// carries its own timestamp, which an implicit relation has nowhere to put.
model LeadAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Doubles as Workpex's "Assigned Date" — the row is created when assigned.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// An agent is assigned to a lead once or not at all.
  @@unique([leadId, userId])
  /// Drives "leads assigned to me", the agent's default view of the list.
  @@index([userId])
  @@map("lead_assignments")
}

/// A per-user pin on a lead (ADR-0031). Pinning is personal — one user's pin must
/// never reorder another user's list — so it lives on this join rather than as a
/// flag on the lead. Unpinning hard-deletes the row: a pin is either present or
/// absent, and re-pinning must not have to revive a tombstone, so there is no
/// soft-delete here (the same rule RefreshToken follows).
model LeadPin {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A user pins a lead once or not at all; the pin/unpin upsert toggles on this.
  @@unique([leadId, userId])
  /// Drives "my pinned leads float to the top of my list".
  @@index([userId])
  @@map("lead_pins")
}

/// A reusable tag (LEAD-01.3 AC1). Workpex shows them as chips on the lead row —
/// "QC VERIFIED" in `leads-list-all-rows-selected-bulk-action-bar.png`.
///
/// A table rather than a string array on the lead: LEAD-12.1 AC4 filters by tag,
/// which wants an indexed join, and renaming a tag should not mean rewriting
/// every lead that carries it.
model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  leads LeadTag[]

  @@map("tags")
}

/// Lead-to-tag link.
model LeadTag {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  /// LEAD-12.1 AC5: the same tag cannot be applied to a lead twice.
  @@unique([leadId, tagId])
  /// LEAD-12.1 AC4: "leads tagged X" reads from this side.
  @@index([tagId])
  @@map("lead_tags")
}

/// A complaint raised against a lead (LEAD-01.3 AC2).
///
/// An entity, not a column on the lead: LEAD-13.1 requires it to carry its own
/// details and a status to track handling, which a single dropdown value cannot.
/// One-to-many rather than one-to-one — Workpex's column is titled COMPLAINTS,
/// and a second complaint must not overwrite the first.
model Complaint {
  id      String @id @default(uuid()) @db.Uuid
  leadId  String @map("lead_id") @db.Uuid
  details String @db.Text

  /// Handling state (LEAD-13.1 AC4). A string for the same reason as lead
  /// status: the values are the business's to define, not a migration's.
  status String @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// AC2: retrieving a lead's complaints is the only access path there is.
  @@index([leadId, deletedAt])
  @@map("complaints")
}

/// A free-text note on a lead (LEAD-10.2 "Add Note", ADR-0035). Workpex's row
/// Add Note action opens a drawer with one textarea; each submit is its own row,
/// so notes append rather than overwrite a single field.
///
/// A dedicated table — never the Call model's `leadNotes`/`callNotes`, which are
/// per-call (CALL-01.1). A lead note is not tied to a call and must accumulate,
/// so it is its own entity like Complaint, not a column on the lead. `authorId`
/// is the resolved caller (CurrentUserService), never client-supplied.
model LeadNote {
  id       String @id @default(uuid()) @db.Uuid
  leadId   String @map("lead_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  body     String @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// Retrieving a lead's notes (newest-first) is the only access path.
  @@index([leadId, deletedAt])
  @@map("lead_notes")
}

/// A bulk-import run (LEAD-07.1).
///
/// Persisted so progress can be polled while rows are written asynchronously, and
/// so the summary, the failed rows and the import history survive the request that
/// started the import. The row processing itself is not held here — only its
/// state — which keeps the table small regardless of file size.
///
/// `module` is a string, not an enum: the same engine imports Customers/Products/
/// Vendors later (the descriptor differs, the table does not), so a new module
/// must not force a migration — the same reason `status` on Lead is a string.
///
/// `errors` holds the standardized row-error objects
/// (`{ rowNumber, values, reason, errorCode }`) that back the downloadable error
/// report and the failed-row review. It is nullable — populated only once a row
/// fails — and lives inline rather than in a child table: at the 10 MB import cap
/// the failed set is bounded, and a second table would buy paging the review does
/// not need.
model ImportJob {
  id       String @id @default(uuid()) @db.Uuid
  module   String @db.VarChar(64)
  status   String @default("PENDING") @db.VarChar(24)
  fileName String @map("file_name") @db.VarChar(260)
  pipeline String @db.VarChar(64)

  /// The applied column → field mapping, kept as the run's audit trail.
  mapping Json

  totalRows     Int @default(0) @map("total_rows")
  processedRows Int @default(0) @map("processed_rows")
  importedCount Int @default(0) @map("imported_count")
  skippedCount  Int @default(0) @map("skipped_count")
  failedCount   Int @default(0) @map("failed_count")

  errors Json?

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// The importer — drives history ("my imports") and the same role scoping the
  /// list uses. Nullable with `SetNull` so removing a user never destroys the
  /// import audit trail.
  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  /// History is "my recent imports, newest first".
  @@index([createdById, createdAt(sort: Desc)])
  @@map("import_jobs")
}

/// A saved per-user table layout — the Manage Columns result (LEAD-05.1 AC3).
///
/// Generic on purpose: `viewKey` names which table the layout is for ("leads"
/// today), so the same store backs the Activities and Kanban Manage Columns
/// drawers without a new table — the same reasoning that keeps `ImportJob.module`
/// a string. It is a user preference, not domain data: one row per user per view,
/// overwritten on Submit, so there is no soft delete (a reset just removes the row
/// and the default returns) — matching LeadAssignment/LeadTag, which also omit it.
///
/// `layout` holds `{ order: string[], hidden: string[] }` keyed by the frontend's
/// column ids. JSON, not columns, because the column set is the client's to define
/// (each entry carries render logic) and must be able to change without a
/// migration; the client reconciles stored keys against the live set on load, so a
/// renamed or new column never leaves a stale layout stuck.
model UserViewPreference {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  viewKey String @map("view_key") @db.VarChar(64)

  layout Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One saved layout per user per view; the upsert target.
  @@unique([userId, viewKey])
  @@map("user_view_preferences")
}

/// A user's saved filter preset (ADR-0052) — one row of the filter panel's checkbox
/// row above the condition builder ("UAE TEAM", "GLOBAL TEAM", "WON", …). The names
/// are the user's own words, not entities: no Team model backs them.
///
/// Shared by the Leads list and the Kanban board deliberately, so a preset saved on
/// one surface is usable on the other (KAN-07.1 AC5). `conditions` stores the exact
/// payload `GET /leads?conditions=` accepts, validated with the existing whitelist on
/// write, so a preset can never carry a field or operator the live builder could not.
model SavedFilter {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  name       String   @db.VarChar(120)
  conditions Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The row shows names, so two presets of the same name would be indistinguishable.
  @@unique([userId, name])
  /// The only read path: "my presets".
  @@index([userId])
  @@map("saved_filters")
}

/// Pipeline stage catalogue (KAN-05.1) — the single, user-editable source of the
/// stage set, colours and order.
///
/// Replaces the config-backed stage list (ADR-0005) that was duplicated on the
/// frontend and backend. Everything that reads stages — the board columns, the list
/// badges, the New Lead status dropdown, filters and reports — sources them here, so
/// the views can no longer drift, and add/rename/recolour/reorder/delete happen only
/// through the Stage Management API.
///
/// A stage belongs to a `pipeline` (AC1), and its `name` IS the value a lead stores
/// in `status`: "status and pipeline stage are ONE field" (LEAD-01.1 AC3). Renaming a
/// stage cascades to the leads carrying its old status so the two never diverge.
///
/// `color` is a palette key (`violet`, `amber`, …), not a CSS class: the store stays
/// framework-agnostic and the frontend maps the key to its design tokens (KAN-05.2).
/// `position` orders the stages within a pipeline (AC3). No soft delete — a stage is a
/// catalogue entry, not domain data, and a delete is guarded (refused while leads sit
/// in it), matching UserViewPreference/LeadTag which also omit `deletedAt`.
model Stage {
  id       String @id @default(uuid()) @db.Uuid
  pipeline String @db.VarChar(64)
  name     String @db.VarChar(64)
  color    String @db.VarChar(32)
  position Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// AC5: a stage name is unique within its pipeline.
  @@unique([pipeline, name])
  /// The board/list read the ordered stage set for one pipeline.
  @@index([pipeline, position])
  @@map("stages")
}

/// Workpex "Follow Up Type" — the required first field of the Add Follow-up
/// drawer, which also drives the derived title (ACT-01.1 gap M1, ADR-0027 dec 1).
/// Fixed by the product, not user-configurable, so an enum is the honest model.
enum ActivityType {
  CALL
  MEETING
  TASK
}

/// A follow-up on a lead (ACT-01.1). Links to the lead, not to a stage
/// (ADR-0027) — so it is independent of the lead's pipeline/status.
///
/// `title` is NOT stored: it is derived "{type} with {lead.name}" (ADR-0027
/// dec 2 / gap C2). `type` is the Workpex Follow Up Type (M1). Due is composed
/// as `dueAt` (Due Date + Start Time); `endAt` is the Meeting/Task End Time (M2).
/// `description` is the "Follow-up Description" — nullable here because imported/
/// legacy rows may lack it, but the create/edit DTO enforces non-empty (C1,
/// resolved required by the video). `locationId` is the optional Location select
/// (Meeting/Task only); its catalogue + on-site check-in are the GPS module's, so
/// there is no FK until that table exists (E1). `completedAt` is ACT-04.1.
model Activity {
  id          String       @id @default(uuid()) @db.Uuid
  type        ActivityType
  leadId      String       @map("lead_id") @db.Uuid
  description String?      @db.Text
  dueAt       DateTime     @map("due_at")
  endAt       DateTime?    @map("end_at")
  completedAt DateTime?    @map("completed_at")
  /// GPS-09.1: the site this follow-up must be carried out at. Null = not location-tied.
  locationId  String?      @map("location_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  lead      Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Restrict: a site with follow-ups tied to it must not vanish and silently
  /// un-gate them.
  location  Location?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  assignees ActivityAssignee[]
  /// GPS-01.1: the field check-ins that verify this follow-up (ACT-10.1 gate).
  checkIns  CheckIn[]

  /// Overdue/Today/Tomorrow/All bucketing compares dueAt to day boundaries.
  @@index([dueAt])
  /// A lead's activities, excluding soft-deleted.
  @@index([leadId, deletedAt])
  /// The Completed tab.
  @@index([completedAt])
  @@map("activities")
}

/// Multi-user assignment (ACT-06.1) — an explicit join mirroring LeadAssignment,
/// so a follow-up appears on every assignee's worklist and drives assignee-based
/// role scope. Completion lives on Activity, not here, so "done" is one truth for
/// all assignees.
model ActivityAssignee {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A user is assigned to a follow-up once or not at all.
  @@unique([activityId, userId])
  /// "activities assigned to me" — the agent's role-scoped view.
  @@index([userId])
  @@map("activity_assignees")
}

/// Direction of a call (CALL-01.1).
enum CallDirection {
  INBOUND
  OUTBOUND
}

/// Outcome of a call (CALL-01.1).
enum CallOutcome {
  ANSWERED
  NO_ANSWER
  BUSY
}

/// A call record (CALL-01.1). Data originates from a connected PBX (3CX),
/// so each attempt is its own row. Supports day-over-day trend analysis.
model Call {
  id         String        @id @default(uuid()) @db.Uuid
  /// The PBX's own call id (CALL-02.1). Ingestion is idempotent on this key so a
  /// replayed 3CX event is not stored twice (AC5). Nullable because CALL-01.1 rows
  /// and any future manual sources have no external id.
  externalId String?       @unique @map("external_id") @db.VarChar(128)
  leadId     String        @map("lead_id") @db.Uuid
  agentId    String        @map("agent_id") @db.Uuid
  phone      String        @db.VarChar(32)
  startedAt  DateTime      @map("started_at")
  direction  CallDirection
  outcome    CallOutcome
  /// Duration in seconds.
  duration   Int           @default(0)
  leadNotes  String?       @map("lead_notes") @db.Text
  callNotes  String?       @map("call_notes") @db.Text
  /// Row-level flag raised from the Recent Call Log's Actions column. Belongs to
  /// the attempt, not the lead, so flagging one call never marks the others.
  flagged    Boolean       @default(false)
  /// The PBX recording for this attempt, when one exists. Null until the live 3CX
  /// transport supplies it (CALL-02.1), which keeps the Audio Clip action honest:
  /// the row's download is disabled rather than dead.
  audioUrl   String?       @map("audio_url") @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  /// Restrict, not Cascade: the app soft-deletes, so a hard delete of a lead or
  /// agent must not silently erase their call history/analytics.
  lead  Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  agent User @relation(fields: [agentId], references: [id], onDelete: Restrict)

  /// The backlog requires an index on date/time and agent.
  @@index([startedAt])
  @@index([agentId, startedAt])
  @@index([leadId, deletedAt])
  @@map("calls")
}

/// A field visit (GPS-01.1). One row per visit: the check-in time/coordinates,
/// plus the check-out time/coordinates once the agent leaves (both nullable
/// until then). May verify a location-tied follow-up (ACT-10.1 gate) via
/// `activityId`. Coordinates are Decimal(9,6) — ~0.1 m precision, signed, and
/// exact (never float drift on a comparison). No PostGIS: the backlog's queries
/// are by agent and period, which a btree index serves.
model CheckIn {
  id          String    @id @default(uuid()) @db.Uuid
  agentId     String    @map("agent_id") @db.Uuid
  checkInAt   DateTime  @map("check_in_at")
  checkInLat  Decimal   @map("check_in_lat") @db.Decimal(9, 6)
  checkInLng  Decimal   @map("check_in_lng") @db.Decimal(9, 6)
  checkOutAt  DateTime? @map("check_out_at")
  checkOutLat Decimal?  @map("check_out_lat") @db.Decimal(9, 6)
  checkOutLng Decimal?  @map("check_out_lng") @db.Decimal(9, 6)
  /// The follow-up this visit verifies; null when the check-in is not tied to one.
  activityId  String?   @map("activity_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  agent    User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting the follow-up must not erase the proof the
  /// visit happened.
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  /// AC4: query a field agent's visits over a period.
  @@index([agentId, checkInAt])
  @@index([activityId])
  @@map("check_ins")
}

/// A named site a follow-up can be tied to (GPS-09.1).
///
/// ADR-0027 modelled `Activity.locationId` as "a soft reference to a location whose
/// catalogue is the GPS module's (no FK until that table exists)". This is that table:
/// the completion gate needs a coordinate to measure a check-in against, and there was
/// nowhere to store one. Owned by GPS because the gate and the check-ins are.
model Location {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(160)
  /// The site's centre. Same precision as CheckIn's coordinates so a distance
  /// between the two is computed from like-for-like values.
  lat          Decimal @db.Decimal(9, 6)
  lng          Decimal @db.Decimal(9, 6)
  /// Per-site override of the configured default radius, in metres. Null = use the
  /// default; a large depot legitimately needs a wider gate than a shop doorway.
  radiusMeters Int?    @map("radius_meters")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  activities Activity[]

  @@index([deletedAt])
  @@map("locations")
}

/// A passive automatic-tracking location point (GPS-01.1) — a stream of pings per
/// field agent. Append-only telemetry, so no soft-delete; a purge is a retention
/// policy, not a per-row delete.
model LocationPoint {
  id         String   @id @default(uuid()) @db.Uuid
  agentId    String   @map("agent_id") @db.Uuid
  recordedAt DateTime @map("recorded_at")
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent User @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// AC2/AC4: an agent's track over a period.
  @@index([agentId, recordedAt])
  @@map("location_points")
}

/// A company-wide document (DOC-01.1). A general-purpose repository — product
/// images, catalogs — independent of any single lead or module (AC4): it carries no
/// lead/activity FK by design.
///
/// The bytes live in the storage backend, never the DB: `storageKey` is the
/// StorageService object key (FND-05.2), and `sizeBytes`/`contentType` are the
/// `StoredObject` metadata that layer returns (AC5). `title` is the human "File Name"
/// the Add drawer captures ("Product Images"); `fileName` is the uploaded file's own
/// name ("LUMINUX3IN1 COMBO.png"), shown as "Attachment" and used as the download
/// name — the two are distinct in `documents-list-default-single-row.png`. `category`
/// is the optional category/folder (AC2): a nullable string via the lookup convention
/// (ADR-0032), no Category table until FND-04.2. Per-document access is the separate
/// `DocumentAccess` whitelist (AC3). Upload/list/download are DOC-02.1+ — absent here.
model Document {
  id          String  @id @default(uuid()) @db.Uuid
  title       String  @db.VarChar(255)
  fileName    String  @map("file_name") @db.VarChar(255)
  /// The StorageService object key — the "file reference" (AC1). Never a public URL;
  /// access is always through a signed download minted later (DOC-02.x).
  storageKey  String  @map("storage_key") @db.VarChar(512)
  sizeBytes   Int     @map("size_bytes")
  /// MIME type from the storage layer; the UI derives the short "png"/"pdf" label.
  contentType String  @map("content_type") @db.VarChar(160)
  /// Optional category/folder (AC2). Null = uncategorised.
  category    String? @db.VarChar(120)
  /// "Uploaded By" (AC1) — the uploader, an immutable audit fact.
  uploaderId  String  @map("uploader_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  /// Restrict, not Cascade: the app soft-deletes, so a hard delete of the uploader
  /// must never erase a document or its ownership (matches Call → agent).
  uploader User             @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  access   DocumentAccess[]

  /// A user's documents, excluding soft-deleted (the "Uploaded By" scope).
  @@index([uploaderId, deletedAt])
  /// The category/folder filter (DOC-06.1).
  @@index([category, deletedAt])
  /// The type filter — the "All Documents" dropdown (DOC-06.1).
  @@index([contentType, deletedAt])
  /// The list opens newest-first by "Date and Time".
  @@index([createdAt(sort: Desc)])
  @@map("documents")
}

/// Per-document access grant (DOC-01.1 AC3) — the "Select Users" whitelist from the
/// Add Document drawer. An explicit join mirroring ActivityAssignee: one row per
/// (document, user) granted access, so a document can be shared with many users and
/// "documents shared with me" reads from the user side. No soft delete — a grant is
/// added or removed, and it Cascades away with its document.
model DocumentAccess {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A user is granted access to a document once or not at all.
  @@unique([documentId, userId])
  /// "documents shared with me" — the per-user access lookup.
  @@index([userId])
  @@map("document_access")
}

/// LEAD-05.1 (ADR-0051): the five custom-column field types Workpex offers in the
/// "Add Column" field-type menu (leads-add-column-dropdown-open-field-type.png). An
/// enum, not a string: the set is fixed by the product, and each type drives a
/// specific input control (create/edit form) and display format (list cell).
enum LeadCustomFieldType {
  TEXT
  TEXTBOX
  NUMBER
  DATE
  DATETIME
}

/// LEAD-05.1 (ADR-0051): a user-defined custom column created from "Add Column".
/// App-global — the platform is single-tenant, so a field defined once is available
/// to everyone; per-user visibility/order stays in UserViewPreference, not here.
/// Soft-deleted (like Tag) so removing a field never orphans a saved column layout —
/// the client's reconcileLayout drops the missing key on the next load.
model LeadCustomField {
  id String @id @default(uuid()) @db.Uuid

  /// Stable column key used in the table and the per-user layout, "cf_<slug>".
  /// Letter-started and <= 64 chars so it satisfies the view-preference COLUMN_KEY
  /// rule and can never collide with a built-in Leads column key.
  key      String              @unique @db.VarChar(64)
  name     String              @db.VarChar(180)
  type     LeadCustomFieldType
  /// Left-to-right position among custom columns; also the default layout order.
  position Int

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  values LeadCustomFieldValue[]

  @@map("lead_custom_fields")
}

/// LEAD-05.1 (ADR-0051): one lead's value for one custom field. Stored as text and
/// interpreted by the field's `type` on read (numbers/dates validated + formatted by
/// type), the same "string with meaning defined elsewhere" model as status/source.
/// No soft delete — a value is owned child data that Cascades away with its lead or
/// its field, and is full-replaced on lead update (like assignments/tags).
model LeadCustomFieldValue {
  id            String @id @default(uuid()) @db.Uuid
  customFieldId String @map("custom_field_id") @db.Uuid
  leadId        String @map("lead_id") @db.Uuid
  value         String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customField LeadCustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  lead        Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// At most one value per (lead, field). Leading leadId also serves the list's
  /// per-page value projection (WHERE lead_id IN (…)).
  @@unique([leadId, customFieldId])
  /// Reverse lookup: all leads' values for one field (future sort/filter).
  @@index([customFieldId])
  @@map("lead_custom_field_values")
}

/// INT-01.1 (ADR-0054): the integration library catalogue — one row per integration,
/// driving the library grid, its provider/category tags and its enabled count.
///
/// App-global, like Stage/Tag/LeadCustomField: the platform is single-tenant, so AC4's
/// "per-organization enablement" is the deployment itself. No Organization model is
/// introduced; if multi-tenancy ever arrives this table migrates like every other.
///
/// Addressed by `key`, not `id` — a UUID regenerated on each rebuild cannot appear in a
/// seed or a URL, and `@unique` makes re-seeding an update rather than a duplicate.
model Integration {
  id String @id @default(uuid()) @db.Uuid

  /// Stable slug ("facebook", "google-ads"); matches the frontend registry ids.
  key String @unique @db.VarChar(64)

  name        String @db.VarChar(120)
  description String @db.VarChar(400)

  /// Provider/category tag (AC1). A string, not an enum: the reference set carries four
  /// values and Workpex already shows a fifth. Nothing branches on it — it is display
  /// text and a client-side filter key, so an enum would cost a migration per tag.
  category String @db.VarChar(64)

  /// AC1's "logo". The product ships no per-provider logo assets, so this holds the icon
  /// key the frontend already resolves; a real asset path drops in with no schema change.
  logo String @db.VarChar(120)

  /// AC2 — enabled vs merely available. Default false: integrations are opt-in.
  enabled Boolean @default(false)

  /// AC3 — optional detail link, null on integrations with no detail page.
  detailUrl String? @map("detail_url") @db.VarChar(300)

  /// Library grid order, preserving the verified card sequence in
  /// ui-reference/integrations/integrations-library-grid-top-web-form-card-hover.png.
  position Int

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  /// The list reads live rows in grid order; soft delete has no automatic filter yet
  /// (CLAUDE.md §11), so every query names deletedAt explicitly.
  @@index([deletedAt, position])
  @@map("integrations")
}

/// App-global configuration for one Settings screen (single-tenant, ADR-0054 — the
/// deployment *is* the organization, so there is no tenant key here either).
///
/// One row per screen, keyed by its slug, holding that screen's payload as JSON. This is
/// deliberately the same key + JSON + upsert shape as `UserViewPreference`, minus the user
/// scope: these are company policy (how leads display for everyone, whether mobile numbers
/// are masked), not a personal preference, so scoping them to a user would be wrong.
///
/// A column per setting was rejected: the Settings area has five more screens behind this
/// one, and each would otherwise cost a migration. The JSON is not a free-for-all — every
/// field is validated by a DTO on write and re-read defensively on read, so a row that
/// predates a shape change degrades to defaults rather than reaching the client malformed.
///
/// No `deletedAt`: a settings row is configuration, not domain data — the same reading as
/// `Stage` and `UserViewPreference`, which also omit it.
model AppSetting {
  id  String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(64)

  value Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// The enquiry Category catalogue — Settings → Sales & CRM Configuration → Category.
///
/// Replaces the hard-coded `categories` lookup exactly as `Stage` replaced the config-backed
/// stage list: a category's `name` IS the value a lead stores in `Lead.category` (a plain
/// string under the ADR-0005 lookup convention), so a rename cascades to the leads carrying
/// the old name and a delete is refused while any lead still references it. The catalogue can
/// never orphan a lead's category.
///
/// `name` is unique across the whole table rather than per parent: a lead identifies its
/// category by name alone, so two categories sharing a name would be indistinguishable to
/// every lead, filter, export and report.
///
/// `parentId` carries the hierarchy the reference screen draws (connector lines and the
/// per-row "+ Add Category"). Cycles are refused in the service; no depth cap is imposed,
/// because unlike the role tree this screen has no level legend to define one.
///
/// No soft delete — a category is a catalogue entry, not domain data, and the delete is
/// guarded, the same reading `Stage` records.
model Category {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique @db.VarChar(120)
  parentId String? @map("parent_id") @db.Uuid
  position Int     @default(0)

  /// The reference row's green Active / grey Inactive badge.
  isActive Boolean @default(true) @map("is_active")

  /// The info popover's "Created by"; null once that user is removed.
  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Restrict, not Cascade: deleting a parent must never silently take its children with it.
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  createdBy User?      @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// The only read path: the whole tree in sibling order.
  @@index([parentId, position])
  @@map("categories")
}
