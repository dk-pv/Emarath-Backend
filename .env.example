NODE_ENV=development
PORT=5000
APP_NAME=Emarath Backend
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DBNAME?sslmode=require"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800
RESET_TOKEN_TTL_SEC=3600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL_MS=60000
COOKIE_SAMESITE=lax
MAIL_FROM="Emarath <no-reply@your-verified-domain>"
WEB_APP_URL=http://localhost:3000
STORAGE_SIGNED_URL_TTL_SEC=300
STORAGE_MAX_BYTES=26214400          
STORAGE_ALLOWED_EXTENSIONS=xlsx,png,jpg,jpeg,pdf,docx,txt,csv,svg
STORAGE_LOCAL_DIR=.storage
STORAGE_LOCAL_BASE_URL=http://localhost:5000/api

SEED_USER_PASSWORD="ChangeMe123!"
