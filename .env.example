NODE_ENV=development
PORT=5001
APP_NAME=Emarath Backend
API_PREFIX=api
# Allowed browser origins. One value, or several separated by commas — `next dev`
# uses 3001 when another app already holds 3000, so both are listed by default.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DBNAME?sslmode=require"
# Outside development (NODE_ENV=staging or production) the app refuses to start unless this
# is a random value of at least 32 characters, never this placeholder (ADR-0095). Generate one
# with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800
RESET_TOKEN_TTL_SEC=3600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL_MS=60000
COOKIE_SAMESITE=lax
# Mail transport (ADR-0032): "log" prints the message instead of sending (default in
# development), "resend" delivers via the Resend HTTP API. Real delivery — password
# reset AND the Lead Email composer — needs MAIL_PROVIDER=resend, a RESEND_API_KEY, and
# a MAIL_FROM on a Resend-verified domain. A yopmail/gmail address CANNOT be a verified
# sender, so it will be rejected; MAIL_FROM must be a domain you control.
# "log" is refused outside development: it writes password-reset links to the log.
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM="Emarath <no-reply@your-verified-domain>"
WEB_APP_URL=http://localhost:3000
STORAGE_SIGNED_URL_TTL_SEC=300
STORAGE_MAX_BYTES=26214400          
STORAGE_ALLOWED_EXTENSIONS=xlsx,png,jpg,jpeg,pdf,docx,txt,csv,svg
STORAGE_LOCAL_DIR=.storage
STORAGE_LOCAL_BASE_URL=http://localhost:5001/api
# "local" in development; staging and production default to "s3" (R2, S3 or MinIO), which
# refuses to start without the bucket and keys below.
# STORAGE_PROVIDER=local
# Signs the local provider's download links. Outside development a local provider needs 32+
# random characters here (ADR-0095); S3 presigns with its own keys and needs none.
# STORAGE_SIGNING_SECRET=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto
# STORAGE_ENDPOINT=

# The seeded accounts' password; each seed has its own development default when unset.
# Set your own locally if you want one. Never commit a real password here.
# SEED_USER_PASSWORD=

# Seeds only write to a database on this machine (ADR-0095). seed:run, seed:integrations and
# seed:users-access may target ONE remote database on purpose, for a single run, by setting
# SEED_ALLOW_REMOTE_DATABASE=<host>/<database> in the shell, never in this file. The fixtures
# (seed:dev-dataset, seed:ui-reference, seed:team-members, seed:documents, seed-calls.mjs) have
# no override.

# The e2e suite never connects to DATABASE_URL: it uses E2E_DATABASE_URL, which must be a local
# disposable database, or, when that is unset, no database at all. Set it in the shell for the
# test run: the e2e setup runs before .env is loaded, so a value in this file is ignored.
#   E2E_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME npm run test:e2e

# The business timezone (ADR-0094): the IANA name whose calendar day decides which delivery
# dates are Today, Tomorrow and Overdue. GCC: UAE Asia/Dubai, Oman Asia/Muscat; Saudi Arabia,
# Qatar, Kuwait and Bahrain Asia/Riyadh. Unset, it is Asia/Dubai. Never an offset like +04:00.
BUSINESS_TIME_ZONE=Asia/Dubai
