
NODE_ENV=development
PORT=5000
APP_NAME=Emarath Backend
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DBNAME?sslmode=require"

# Authentication (AUTH-01.2). JWT_ACCESS_SECRET is REQUIRED in production; in
# development a built-in insecure default is used if unset. Never commit a real secret.
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800
# Password-reset link lifetime in seconds (AUTH-03.1). Short-lived + single-use.
RESET_TOKEN_TTL_SEC=3600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL_MS=60000
# Cookie SameSite policy: lax (same parent domain, recommended) | none (cross-site) | strict
COOKIE_SAMESITE=lax

# Mail delivery (AUTH-03.1, ADR-0031). Provider is chosen by environment: `log` in
# development (the reset link is written to the server log, no network needed), `resend`
# in staging/production. Set MAIL_PROVIDER to override. RESEND_API_KEY + MAIL_FROM are
# REQUIRED when the provider is `resend`; never commit a real API key.
# MAIL_PROVIDER=resend
# RESEND_API_KEY="re_xxxxxxxx"
MAIL_FROM="Emarath <no-reply@your-verified-domain>"
# Frontend origin used to build the reset link (<WEB_APP_URL>/reset-password?token=…).
WEB_APP_URL=http://localhost:3000

# Seed accounts' dev password (AUTH-01.1). Never a real credential.
SEED_USER_PASSWORD="ChangeMe123!"
