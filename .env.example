
NODE_ENV=development
PORT=5000
APP_NAME=Emarath Backend
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DBNAME?sslmode=require"

# Authentication (AUTH-01.2). JWT_ACCESS_SECRET is REQUIRED in production; in
# development a built-in insecure default is used if unset. Never commit a real secret.
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800
# Password-reset link lifetime in seconds (AUTH-03.1). Short-lived + single-use.
RESET_TOKEN_TTL_SEC=3600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL_MS=60000
# Cookie SameSite policy: lax (same parent domain, recommended) | none (cross-site) | strict
COOKIE_SAMESITE=lax

# Mail delivery (AUTH-03.1, ADR-0031). Provider is chosen by environment: `log` in
# development (the reset link is written to the server log, no network needed), `resend`
# in staging/production. Set MAIL_PROVIDER to override. RESEND_API_KEY + MAIL_FROM are
# REQUIRED when the provider is `resend`; never commit a real API key.
# MAIL_PROVIDER=resend
# RESEND_API_KEY="re_xxxxxxxx"
MAIL_FROM="Emarath <no-reply@your-verified-domain>"
# Frontend origin used to build the reset link (<WEB_APP_URL>/reset-password?token=…).
WEB_APP_URL=http://localhost:3000

# File storage (FND-05.2). Provider is chosen by environment: `local` in development
# (files under STORAGE_LOCAL_DIR, no cloud account needed), `s3` in staging/production.
# The `s3` adapter talks the S3 protocol, so the same config drives Cloudflare R2, AWS S3
# or MinIO — only the endpoint/region/keys differ. STORAGE_BUCKET + the two keys are
# REQUIRED when the provider is `s3`; never commit real keys.
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=emarath-documents
# STORAGE_REGION=auto                 # R2: "auto"; AWS S3: a real region e.g. ap-southeast-1
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# STORAGE_ACCESS_KEY_ID="..."
# STORAGE_SECRET_ACCESS_KEY="..."
# STORAGE_FORCE_PATH_STYLE=false      # set true for MinIO
STORAGE_SIGNED_URL_TTL_SEC=300
STORAGE_MAX_BYTES=26214400            # 25 MB
STORAGE_ALLOWED_EXTENSIONS=xlsx,png,jpg,jpeg,pdf,docx,txt,csv,svg
# Local adapter (development) only:
STORAGE_LOCAL_DIR=.storage
STORAGE_LOCAL_BASE_URL=http://localhost:5000/api
# STORAGE_SIGNING_SECRET="change-me"  # dev default is used when unset

# Seed accounts' dev password (AUTH-01.1). Never a real credential.
SEED_USER_PASSWORD="ChangeMe123!"
